{
  "compileOnSave": false,
  "compilerOptions": {
    "composite": true,
    "outDir": "build",
    "rootDir": "./src",
    "moduleDetection": "auto",
    "lib": [
      "ES2023"
    ],
    "declaration": true,
    "sourceMap": true,
    "target": "ES2023",
    "module": "CommonJS",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "importHelpers": true,
    "noEmitHelpers": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "allowSyntheticDefaultImports": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "pretty": true,
    "types": [
      "node"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build/",
    "dist*"
  ]
}