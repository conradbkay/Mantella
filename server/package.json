{
  "name": "mantella-server",
  "version": "1.0.0",
  "description": "Mantella server",
  "main": "index.js",
  "tasks": [
    {
      "type": "npm",
      "script": "fix",
      "problemMatcher": {
        "base": "$tslint5",
        "fileLocation": "relative"
      }
    }
  ],
  "engines": {
    "node": "23.11.0",
    "npm": "10.9.0"
  },
  "scripts": {
    "start": "pm2-runtime start ./ecosystem.config.js --env production",
    "dev": "nodemon",
    "clean": "rimraf build",
    "build": "npm run clean && tsc",
    "codegen": "npx tsx src/db/db.ts && kysely-codegen --dialect sqlite --out-file src/shared/types-gen.ts --url ./db/mantella.db",
    "test": "tsx --test --test-force-exit src/**/*.test.ts",
    "test:watch": "tsx --test --watch src/**/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/**/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@typegoose/typegoose": "^12.16.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "better-sqlite3-session-store": "^0.1.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "debug": "^4.4.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "kysely": "^0.28.2",
    "kysely-codegen": "^0.18.5",
    "morgan": "^1.10.0",
    "nanoid": "^5.1.5",
    "node-fetch": "^3.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pm2": "^6.0.8",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^6.0.1",
    "session-file-store": "^1.5.0",
    "tsx": "^4.20.3",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.17.0",
    "@types/cookie-parser": "^1.4.1",
    "@types/cors": "^2.8.4",
    "@types/debug": "0.0.31",
    "@types/express": "^4.11.1",
    "@types/express-session": "^1.15.12",
    "@types/jsonwebtoken": "^8.3.2",
    "@types/morgan": "^1.9.3",
    "@types/node": "^24.0.1",
    "@types/node-fetch": "^2.3.7",
    "@types/passport": "^1.0.0",
    "@types/passport-local": "^1.0.33",
    "@types/session-file-store": "^1.2.2",
    "@types/supertest": "^2.0.16",
    "nodemon": "^3.0.0",
    "prettier": "^2.4.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "kysely-codegen": {
      "better-sqlite3": "$better-sqlite3"
    },
    "better-sqlite3-session-store": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}
